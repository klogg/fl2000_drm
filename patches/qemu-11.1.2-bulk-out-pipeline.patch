From: Artem Mygaiev <joculator@gmail.com>
Subject: [PATCH] usb-host: Allow opt-in bulk OUT pipelining

FL2000 bulk frame transfers stall at about half the scanout rate when
usb-host serializes payloads and their zero-length frame delimiters.
Add an opt-in property to keep multiple bulk OUT requests in flight.

Release failed submissions before returning to avoid dangling requests.
On pipelined OUT submission failure, serialize the endpoint and retry
at the queue head. Reset the copied-byte count before retrying so that
packets cannot complete out of order or overrun their payload buffer.
Report resource errors as I/O failures instead of device removal.

Signed-off-by: Artem Mygaiev <joculator@gmail.com>
---
--- a/hw/usb/host-libusb.c
+++ b/hw/usb/host-libusb.c
@@ -77,6 +77,7 @@
 
 enum USBHostDeviceOptions {
     USB_HOST_OPT_PIPELINE,
+    USB_HOST_OPT_BULK_OUT_PIPELINE,
 };
 
 struct USBHostDevice {
@@ -939,6 +940,10 @@
             usb_ep_set_type(udev, pid, ep, type);
             usb_ep_set_ifnum(udev, pid, ep, i);
             usb_ep_set_halted(udev, pid, ep, 0);
+            if (type == USB_ENDPOINT_XFER_BULK && pid == USB_TOKEN_OUT &&
+                (s->options & (1 << USB_HOST_OPT_BULK_OUT_PIPELINE))) {
+                usb_ep_get(udev, pid, ep)->pipeline = true;
+            }
 #ifdef HAVE_STREAMS
             if (type == LIBUSB_TRANSFER_TYPE_BULK &&
                     libusb_get_ss_endpoint_companion_descriptor(ctx, endp,
@@ -1532,7 +1537,10 @@
                                  CONTROL_TIMEOUT);
     rc = libusb_submit_transfer(r->xfer);
     if (rc != 0) {
-        p->status = USB_RET_NODEV;
+        usb_host_libusb_error("libusb_submit_transfer [control]", rc);
+        usb_host_req_free(r);
+        p->status = rc == LIBUSB_ERROR_NO_DEVICE ?
+                    USB_RET_NODEV : USB_RET_IOERROR;
         trace_usb_host_req_complete(s->bus_num, s->addr, p,
                                     p->status, p->actual_length);
         if (rc == LIBUSB_ERROR_NO_DEVICE) {
@@ -1626,7 +1634,23 @@
 
     rc = libusb_submit_transfer(r->xfer);
     if (rc != 0) {
-        p->status = USB_RET_NODEV;
+        usb_host_libusb_error("libusb_submit_transfer [data]", rc);
+        usb_host_req_free(r);
+        p->actual_length = 0;
+        /*
+         * A pipelined endpoint cannot complete a new packet synchronously
+         * ahead of earlier requests. Serialize this endpoint and retry the
+         * packet once it reaches the head, where a synchronous error is safe.
+         * The endpoint remains serialized until its next configuration.
+         */
+        if (p->pid == USB_TOKEN_OUT && p->ep->pipeline &&
+            !QTAILQ_EMPTY(&p->ep->queue)) {
+            p->ep->pipeline = false;
+            p->status = USB_RET_ADD_TO_QUEUE;
+            return;
+        }
+        p->status = rc == LIBUSB_ERROR_NO_DEVICE ?
+                    USB_RET_NODEV : USB_RET_IOERROR;
         trace_usb_host_req_complete(s->bus_num, s->addr, p,
                                     p->status, p->actual_length);
         if (rc == LIBUSB_ERROR_NO_DEVICE) {
@@ -1784,6 +1808,8 @@
                      allow_all_guest_resets, false),
     DEFINE_PROP_UINT32("loglevel",  USBHostDevice, loglevel,
                        LIBUSB_LOG_LEVEL_WARNING),
+    DEFINE_PROP_BIT("bulk-out-pipeline", USBHostDevice, options,
+                    USB_HOST_OPT_BULK_OUT_PIPELINE, false),
     DEFINE_PROP_BIT("pipeline",    USBHostDevice, options,
                     USB_HOST_OPT_PIPELINE, true),
     DEFINE_PROP_BOOL("suppress-remote-wake", USBHostDevice,
