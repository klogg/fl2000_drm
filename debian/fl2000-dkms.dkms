PACKAGE_NAME="fl2000-drm"
PACKAGE_VERSION="#MODULE_VERSION#"
AUTOINSTALL="yes"
BUILD_EXCLUSIVE_KERNEL="^7\.0\."
BUILD_EXCLUSIVE_ARCH="^x86_64$"
MAKE[0]="make KVER=${kernelver} KSRC=${kernel_source_dir} FL2000_HELPER_SOURCE_DIR=${dkms_tree}/${PACKAGE_NAME}/${PACKAGE_VERSION}/build/compat/linux-7.0"
BUILT_MODULE_NAME[0]="fl2000"
BUILT_MODULE_LOCATION[0]="."
DEST_MODULE_LOCATION[0]="/updates/dkms"
BUILT_MODULE_NAME[1]="it66121"
BUILT_MODULE_LOCATION[1]="."
DEST_MODULE_LOCATION[1]="/updates/dkms"
