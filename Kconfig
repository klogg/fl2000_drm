config DRM_FL2000
	tristate "Fresco Logic FL2000 USB display adapters"
	depends on DRM && USB && I2C && MMU
	select DRM_KMS_HELPER
	select DRM_GEM_SHMEM_HELPER
	select DRM_BRIDGE
	select DRM_DISPLAY_HELPER
	select DRM_BRIDGE_CONNECTOR
	select REGMAP
	select IRQ_DOMAIN
	help
	  DRM/KMS and I2C transport support for Fresco Logic FL2000 USB
	  display adapters. Configure the attached bridge independently.
	  The FL2000 transport does not identify or instantiate a bridge.

	  If built as a module, this is called fl2000.

choice
	prompt "FL2000 frame preparation backend"
	depends on DRM_FL2000
	default DRM_FL2000_FRAME_SSSE3 if X86_64 && ARCH_HAS_KERNEL_FPU_SUPPORT
	default DRM_FL2000_FRAME_GENERIC
	help
	  Select the optional architecture-specific frame converter. Each
	  accelerated backend retains the portable implementation as a
	  runtime fallback when the processor lacks the required features.

config DRM_FL2000_FRAME_GENERIC
	bool "Portable scalar implementation"

config DRM_FL2000_FRAME_SSSE3
	bool "x86-64 SSSE3 conversion"
	depends on X86_64 && ARCH_HAS_KERNEL_FPU_SUPPORT

config DRM_FL2000_FRAME_BMI2
	bool "x86-64 BMI2 conversion"
	depends on X86_64

endchoice

config DRM_FL2000_IT66121
	tristate "IT66121 bridge with FL2000 transport adaptations"
	depends on DRM_FL2000
	depends on DRM_ITE_IT66121 = n
	select REGMAP_I2C
	help
	  Optional transport-adapted IT66121 bridge. Instantiate its I2C
	  client explicitly on the FL2000 adapter. This module shares the
	  standard IT66121 module name and cannot be enabled alongside it.

	  If built as a module, this is called it66121.
